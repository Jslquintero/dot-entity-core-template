{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Template.Api",
    "Audience": "Template.Client",
    "ExpirationMinutes": 15
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Seed": {
    "Enabled": false
  },
  "Hangfire": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
